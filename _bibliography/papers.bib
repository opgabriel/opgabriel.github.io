 url = {https://sol.sbc.org.br/index.php/brasnam/article/view/16130},
 abstract = {In Brazil, each region has its own cultural identity regarding accent, gastronomy, customs, all of which may reflect in its literature. Specially, we believe that country's background and contextual features are directly related to what people read. Hence, we perform a cross-state comparison analysis based on Brazilian reading preferences through a multipartite network model. Also, we explore the effects of socioeconomic and demographic factors on favorite books and writing genres. Such cross-state analyses highlight how the country is culturally rich, where each region has its own distinctive culture. Our findings offer great opportunities for the Brazilian book industry by enhancing current knowledge on social indicators related to reading preferences.},
